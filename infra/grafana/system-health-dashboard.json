    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Share of HTTP responses returning 5xx, as a percentage of all responses, over a 5-minute window. Above 1% sustained = investigate; above 5% = page. M01 plan target: <1% under normal load.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
