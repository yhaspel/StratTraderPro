          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "100 * (sum(rate(django_http_responses_total_by_status_view_method_total{env=~\"$env\", status=~\"5..\"}[5m])) or vector(0)) / clamp_min(sum(rate(django_http_responses_total_by_status_view_method_total{env=~\"$env\"}[5m])), 1)",
