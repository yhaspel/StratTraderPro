            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(django_http_requests_latency_seconds_by_view_method_bucket{env=~\"$env\"}[5m])))",
          "legendFormat": "p99",
          "range": true,
          "refId": "C"
