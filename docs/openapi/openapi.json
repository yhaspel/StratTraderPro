openapi: 3.0.3
info:
  title: StratTraderPro API
  version: 0.0.0
  description: Trading bot platform API — webhook-driven, regime-aware, multi-broker.
paths:
  /api/v1/auth/login/:
    post:
      operationId: auth_login
      description: Returns `{access, refresh, user, mfa_required}`. `mfa_required`
        is always false in M01 (MFA ships in M02).
      summary: Log in with email + password
      tags:
      - auth
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/Login'
            examples:
              LoginRequest:
                value:
                  email: trader@example.com
                  password: correct horse battery staple
                summary: Login request
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/Login'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/Login'
        required: true
      security:
      - jwtAuth: []
      - {}
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/TokenPairEnvelope'
          description: ''
        '401':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ErrorEnvelope'
              examples:
                InvalidCredentials:
                  value:
                    error:
                      code: INVALID_CREDENTIALS
                      message: Invalid email or password.
                  summary: Invalid credentials
          description: ''
        '403':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ErrorEnvelope'
              examples:
                EmailNotVerified:
                  value:
                    error:
                      code: EMAIL_NOT_VERIFIED
                      message: Please verify your email before signing in.
                  summary: Email not verified
          description: ''
        '423':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ErrorEnvelope'
              examples:
                AccountLocked:
                  value:
                    error:
                      code: ACCOUNT_LOCKED
                      message: Account temporarily locked due to repeated failures.
                  summary: Account locked
          description: ''
        '429':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ErrorEnvelope'
              examples:
                RateLimited:
                  value:
                    error:
                      code: RATE_LIMITED
                      message: Too many requests.
                  summary: Rate limited
          description: ''
  /api/v1/auth/logout/:
    post:
      operationId: auth_logout
      summary: Log out — revokes refresh family
      tags:
      - auth
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/Logout'
            examples:
              LogoutRequest:
                value:
                  refresh: eyJhbGciOi...refresh.jwt
                summary: Logout request
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/Logout'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/Logout'
        required: true
      security:
      - jwtAuth: []
      - {}
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/StatusEnvelope'
          description: ''
  /api/v1/auth/mfa/backup-codes/regenerate/:
    post:
      operationId: auth_mfa_regenerate_backup
      summary: Replace the user's set of backup codes with a fresh batch of 10.
      tags:
      - mfa
      security:
      - jwtAuth: []
      responses:
        '200':
          description: No response body
  /api/v1/auth/mfa/disable/:
    post:
      operationId: auth_mfa_disable
      summary: Disable MFA. Requires both current password and a current TOTP code.
      tags:
      - mfa
      security:
      - jwtAuth: []
      responses:
        '200':
          description: No response body
  /api/v1/auth/mfa/enroll/:
    post:
      operationId: auth_mfa_enroll
      description: Generate (or replace) a pending MFA device. Returns the QR PNG
        (base64) + raw secret. Confirm via /enroll/confirm/.
      summary: Begin TOTP enrollment
      tags:
      - mfa
      security:
      - jwtAuth: []
      responses:
        '200':
          description: No response body
  /api/v1/auth/mfa/enroll/confirm/:
    post:
      operationId: auth_mfa_enroll_confirm
      summary: Confirm TOTP enrollment with a verification code
      tags:
      - mfa
      security:
      - jwtAuth: []
      responses:
        '200':
          description: No response body
  /api/v1/auth/mfa/verify/:
    post:
      operationId: auth_mfa_verify
      summary: Complete MFA challenge — exchange mfa_token + code for tokens
      tags:
      - mfa
      security:
      - jwtAuth: []
      - {}
      responses:
        '200':
          description: No response body
  /api/v1/auth/password/reset/:
    post:
      operationId: auth_password_reset
      description: Always returns 200 to avoid email enumeration.
      summary: Request a password reset email
      tags:
      - auth
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/PasswordReset'
            examples:
              ResetRequest:
                value:
                  email: trader@example.com
                summary: Reset request
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/PasswordReset'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/PasswordReset'
        required: true
      security:
      - jwtAuth: []
      - {}
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/StatusEnvelope'
          description: ''
        '429':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ErrorEnvelope'
              examples:
                RateLimited:
                  value:
                    error:
                      code: RATE_LIMITED
                      message: Too many requests.
                  summary: Rate limited
          description: ''
  /api/v1/auth/password/reset/confirm/:
    post:
      operationId: auth_password_reset_confirm
      description: Issues a JWT pair on success and revokes any outstanding refresh
        families.
      summary: Set a new password using the reset token
      tags:
      - auth
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/PasswordResetConfirm'
            examples:
              ConfirmRequest:
                value:
                  token: prv_7a1c...sample
                  password: correct horse battery staple
                summary: Confirm request
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/PasswordResetConfirm'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/PasswordResetConfirm'
        required: true
      security:
      - jwtAuth: []
      - {}
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/TokenPairEnvelope'
          description: ''
        '400':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ErrorEnvelope'
              examples:
                TokenInvalidOrExpired:
                  value:
                    error:
                      code: TOKEN_INVALID
                      message: Token is invalid or expired.
                  summary: Token invalid or expired
                PasswordDoesNotMeetPolicy:
                  value:
                    error:
                      code: PASSWORD_WEAK
                      message: Password does not meet policy.
                      details:
                        password:
                        - This password is too common.
                  summary: Password does not meet policy
          description: ''
  /api/v1/auth/refresh/:
    post:
      operationId: auth_refresh
      description: Consumes the supplied refresh token and issues a new pair in the
        same family. Reusing an already-rotated refresh revokes the whole family.
      summary: Rotate a refresh token
      tags:
      - auth
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/Refresh'
            examples:
              RefreshRequest:
                value:
                  refresh: eyJhbGciOi...refresh.jwt
                summary: Refresh request
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/Refresh'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/Refresh'
        required: true
      security:
      - jwtAuth: []
      - {}
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/TokenPairEnvelope'
          description: ''
        '401':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ErrorEnvelope'
              examples:
                TokenInvalidOrExpired:
                  value:
                    error:
                      code: TOKEN_INVALID
                      message: Token is invalid or expired.
                  summary: Token invalid or expired
          description: ''
  /api/v1/auth/register/:
    post:
      operationId: auth_register
      description: Creates a new user and sends a verification email. Duplicate emails
        return 202 with a generic body to prevent enumeration.
      summary: Register a new account
      tags:
      - auth
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/Register'
            examples:
              RegisterRequest:
                value:
                  email: trader@example.com
                  display_name: Jane Trader
                  password: correct horse battery staple
                summary: Register request
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/Register'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/Register'
        required: true
      security:
      - jwtAuth: []
      - {}
      responses:
        '201':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/RegisterOkEnvelope'
          description: ''
        '202':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/StatusEnvelope'
          description: ''
        '400':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ErrorEnvelope'
              examples:
                PasswordDoesNotMeetPolicy:
                  value:
                    error:
                      code: PASSWORD_WEAK
                      message: Password does not meet policy.
                      details:
                        password:
                        - This password is too common.
                  summary: Password does not meet policy
                ValidationError:
                  value:
                    error:
                      code: VALIDATION_ERROR
                      message: Invalid input.
                      details:
                        email:
                        - Enter a valid email address.
                  summary: Validation error
          description: ''
        '429':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ErrorEnvelope'
              examples:
                RateLimited:
                  value:
                    error:
                      code: RATE_LIMITED
                      message: Too many requests.
                  summary: Rate limited
          description: ''
  /api/v1/auth/resend-verification/:
    post:
      operationId: auth_resend_verification
      description: Idempotent. Always returns 200 to avoid email enumeration.
      summary: Resend verification email
      tags:
      - auth
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/ResendVerification'
            examples:
              ResendRequest:
                value:
                  email: trader@example.com
                summary: Resend request
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/ResendVerification'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/ResendVerification'
        required: true
      security:
      - jwtAuth: []
      - {}
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/StatusEnvelope'
          description: ''
        '429':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ErrorEnvelope'
              examples:
                RateLimited:
                  value:
                    error:
                      code: RATE_LIMITED
                      message: Too many requests.
                  summary: Rate limited
          description: ''
  /api/v1/auth/verify-email/:
    post:
      operationId: auth_verify_email
      description: Consumes the verification token and returns a JWT pair on success.
      summary: Verify email via token
      tags:
      - auth
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/VerifyEmail'
            examples:
              VerifyRequest:
                value:
                  token: uvv_6d2c...sample
                summary: Verify request
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/VerifyEmail'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/VerifyEmail'
        required: true
      security:
      - jwtAuth: []
      - {}
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/TokenPairEnvelope'
          description: ''
        '400':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ErrorEnvelope'
              examples:
                TokenInvalidOrExpired:
                  value:
                    error:
                      code: TOKEN_INVALID
                      message: Token is invalid or expired.
                  summary: Token invalid or expired
          description: ''
  /api/v1/brokers/ping/:
    get:
      operationId: v1_brokers_ping_retrieve
      description: 200 OK iff caller is authenticated AND has MFA enabled.
      tags:
      - v1
      security:
      - jwtAuth: []
      responses:
        '200':
          description: No response body
  /api/v1/orders/ping/:
    get:
      operationId: v1_orders_ping_retrieve
      tags:
      - v1
      security:
      - jwtAuth: []
      responses:
        '200':
          description: No response body
  /api/v1/risk/ping/:
    get:
      operationId: v1_risk_ping_retrieve
      tags:
      - v1
      security:
      - jwtAuth: []
      responses:
        '200':
          description: No response body
  /api/v1/strategies/ping/:
    get:
      operationId: v1_strategies_ping_retrieve
      tags:
      - v1
      security:
      - jwtAuth: []
      responses:
        '200':
          description: No response body
  /api/v1/users/me/:
    get:
      operationId: users_me
      summary: Get the currently authenticated user
      tags:
      - auth
      security:
      - jwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/CurrentUserEnvelope'
              examples:
                CurrentUser:
                  value:
                    data:
                      id: 6f2e5a1d-0c9b-4b4e-8d6a-111111111111
                      email: trader@example.com
                      display_name: Jane Trader
                      is_verified: true
                      created_at: '2026-04-17T12:00:00Z'
                  summary: Current user
          description: ''
        '401':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ErrorEnvelope'
          description: ''
  /api/v1/users/me/password/:
    post:
      operationId: users_me_password_change
      summary: Change password. Revokes all other refresh sessions.
      tags:
      - users
      security:
      - jwtAuth: []
      responses:
        '200':
          description: No response body
  /api/v1/users/me/sessions/:
    get:
      operationId: users_me_sessions
      summary: List the user's active refresh-token families.
      tags:
      - users
      security:
      - jwtAuth: []
      responses:
        '200':
          description: No response body
  /api/v1/users/me/sessions/revoke/:
    post:
      operationId: users_me_sessions_revoke
      summary: Revoke a single session by family_id, OR all-other if all=true.
      tags:
      - users
      security:
      - jwtAuth: []
      responses:
        '200':
          description: No response body
  /api/v1/users/me/update/:
    patch:
      operationId: users_me_update
      summary: Update display_name / timezone / language / notification preferences
      tags:
      - users
      security:
      - jwtAuth: []
      responses:
        '200':
          description: No response body
components:
  schemas:
    ApiError:
      type: object
      properties:
        code:
          type: string
          description: Stable machine-readable error code.
        message:
          type: string
        details:
          type: object
          additionalProperties:
            type: array
            items:
              type: string
          description: Optional field→messages map for validation errors.
      required:
      - code
      - message
    AuthUser:
      type: object
      properties:
        id:
          type: string
          format: uuid
        email:
          type: string
          format: email
        display_name:
          type: string
        is_verified:
          type: boolean
        mfa_enabled:
          type: boolean
      required:
      - display_name
      - email
      - id
      - is_verified
    CurrentUserEnvelope:
      type: object
      properties:
        data:
          $ref: '#/components/schemas/_CurrentUserData'
      required:
      - data
    ErrorEnvelope:
      type: object
      properties:
        error:
          $ref: '#/components/schemas/ApiError'
      required:
      - error
    Login:
      type: object
      properties:
        email:
          type: string
          format: email
        password:
          type: string
          writeOnly: true
      required:
      - email
      - password
    Logout:
      type: object
      properties:
        refresh:
          type: string
      required:
      - refresh
    PasswordReset:
      type: object
      properties:
        email:
          type: string
          format: email
      required:
      - email
    PasswordResetConfirm:
      type: object
      properties:
        token:
          type: string
        password:
          type: string
          writeOnly: true
          maxLength: 256
          minLength: 12
      required:
      - password
      - token
    Refresh:
      type: object
      properties:
        refresh:
          type: string
      required:
      - refresh
    Register:
      type: object
      properties:
        email:
          type: string
          format: email
        display_name:
          type: string
          maxLength: 64
          minLength: 1
        password:
          type: string
          writeOnly: true
          maxLength: 256
          minLength: 12
      required:
      - display_name
      - email
      - password
    RegisterData:
      type: object
      properties:
        id:
          type: string
          format: uuid
        email:
          type: string
          format: email
      required:
      - email
      - id
    RegisterOkEnvelope:
      type: object
      properties:
        data:
          $ref: '#/components/schemas/RegisterData'
      required:
      - data
    ResendVerification:
      type: object
      properties:
        email:
          type: string
          format: email
      required:
      - email
    StatusData:
      type: object
      properties:
        status:
          type: string
      required:
      - status
    StatusEnvelope:
      type: object
      properties:
        data:
          $ref: '#/components/schemas/StatusData'
      required:
      - data
    TokenPairData:
      type: object
      properties:
        access:
          type: string
        refresh:
          type: string
        user:
          $ref: '#/components/schemas/AuthUser'
        mfa_required:
          type: boolean
      required:
      - access
      - refresh
      - user
    TokenPairEnvelope:
      type: object
      properties:
        data:
          $ref: '#/components/schemas/TokenPairData'
      required:
      - data
    VerifyEmail:
      type: object
      properties:
        token:
          type: string
      required:
      - token
    _CurrentUserData:
      type: object
      properties:
        id:
          type: string
          format: uuid
        email:
          type: string
          format: email
        display_name:
          type: string
        is_verified:
          type: boolean
        created_at:
          type: string
          format: date-time
      required:
      - created_at
      - display_name
      - email
      - id
      - is_verified
  securitySchemes:
    jwtAuth:
      type: http
      scheme: bearer
      bearerFormat: JWT
