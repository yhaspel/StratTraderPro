      operationId: users_me
      summary: Get the currently authenticated user
      tags:
      - auth
      security:
      - jwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/CurrentUserEnvelope'
              examples:
                CurrentUser:
                  value:
                    data:
                      id: 6f2e5a1d-0c9b-4b4e-8d6a-111111111111
                      email: trader@example.com
                      display_name: Jane Trader
                      is_verified: true
                      created_at: '2026-04-17T12:00:00Z'
                  summary: Current user
          description: ''
        '401':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ErrorEnvelope'
          description: ''
  /api/v1/users/me/password/:
    post:
      operationId: users_me_password_change
      summary: Change password. Revokes all other refresh sessions.
      tags:
      - users
      security:
      - jwtAuth: []
      responses:
        '200':
          description: No response body
  /api/v1/users/me/sessions/:
    get:
      operationId: users_me_sessions
      summary: List the user's active refresh-token families.
      tags:
      - users
      security:
      - jwtAuth: []
      responses:
        '200':
          description: No response body
  /api/v1/users/me/sessions/revoke/:
    post:
      operationId: users_me_sessions_revoke
      summary: Revoke a single session by family_id, OR all-other if all=true.
      tags:
      - users
      security:
      - jwtAuth: []
      responses:
        '200':
          description: No response body
  /api/v1/users/me/update/:
    patch:
      operationId: users_me_update
      summary: Update display_name / timezone / language / notification preferences
      tags:
      - users
      security:
      - jwtAuth: []
      responses:
        '200':
          description: No response body
  /hooks/v1/{user_id}/{strategy_id}/:
    post:
      operationId: webhook_ingest
      tags:
      - webhooks
      summary: TradingView webhook ingest (secret-authenticated in body).
      description: Public endpoint mounted outside `/api/v1` — no JWT auth. Authentication
        is a constant-time match of the static bearer `sig` secret embedded in the
        alert body (see ADR-042). Hardened with a per-user rate limit (before body
        read), a 16 KB body cap, `application/json`-only, 24h idempotency, and a halt
        gate.
      security: []
      parameters:
      - name: user_id
        in: path
        required: true
        schema:
          type: string
          format: uuid
      - name: strategy_id
        in: path
        required: true
        schema:
          type: string
          format: uuid
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              required:
              - strategy
              - action
              - symbol
              - qty
              - order_type
              - sig
              properties:
                strategy:
                  type: string
                action:
                  type: string
                  enum:
                  - buy
                  - sell
                  - exit
                symbol:
                  type: string
                qty:
                  type: number
                order_type:
                  type: string
                  enum:
                  - MKT
                  - LMT
                limit_price:
                  type: number
                sig:
                  type: string
                  description: Static bearer secret.
                idempotency_key:
                  type: string
      responses:
        '200':
          description: Accepted / duplicate / halted (see body).
        '400':
          description: Invalid JSON or schema validation failure.
        '401':
          description: Missing/invalid secret (generic — no oracle).
        '413':
          description: Payload exceeds 16 KB.
        '415':
          description: Content-Type is not application/json.
        '429':
          description: Per-user rate limit exceeded.
        '503':
          description: Webhook ingest disabled by ops.
components:
  schemas:
    ApiError:
      type: object
      properties:
        code:
          type: string
          description: Stable machine-readable error code.
        message:
          type: string
        details:
          type: object
          additionalProperties:
            type: array
            items:
              type: string
          description: Optional field→messages map for validation errors.
      required:
      - code
      - message
    AuthUser:
      type: object
      properties:
        id:
          type: string
          format: uuid
        email:
          type: string
          format: email
        display_name:
          type: string
        is_verified:
          type: boolean
        mfa_enabled:
          type: boolean
      required:
      - display_name
      - email
      - id
      - is_verified
    CurrentUserEnvelope:
      type: object
      properties:
        data:
          $ref: '#/components/schemas/_CurrentUserData'
      required:
      - data
    ErrorEnvelope:
      type: object
      properties:
        error:
          $ref: '#/components/schemas/ApiError'
      required:
      - error
    Login:
      type: object
      properties:
        email:
          type: string
          format: email
        password:
          type: string
          writeOnly: true
      required:
      - email
      - password
    Logout:
      type: object
      properties:
        refresh:
          type: string
      required:
      - refresh
    PasswordReset:
      type: object
      properties:
        email:
          type: string
          format: email
      required:
      - email
    PasswordResetConfirm:
      type: object
      properties:
        token:
          type: string
        password:
          type: string
          writeOnly: true
          maxLength: 256
          minLength: 12
      required:
      - password
      - token
    Refresh:
      type: object
      properties:
        refresh:
          type: string
      required:
      - refresh
    Register:
      type: object
      properties:
        email:
          type: string
          format: email
        display_name:
          type: string
          maxLength: 64
          minLength: 1
        password:
          type: string
          writeOnly: true
          maxLength: 256
          minLength: 12
      required:
      - display_name
      - email
      - password
    RegisterData:
      type: object
      properties:
        id:
          type: string
          format: uuid
        email:
          type: string
          format: email
      required:
      - email
      - id
    RegisterOkEnvelope:
      type: object
      properties:
        data:
          $ref: '#/components/schemas/RegisterData'
      required:
      - data
    ResendVerification:
      type: object
      properties:
        email:
          type: string
          format: email
      required:
      - email
    StatusData:
      type: object
      properties:
        status:
          type: string
      required:
      - status
    StatusEnvelope:
      type: object
      properties:
        data:
          $ref: '#/components/schemas/StatusData'
      required:
      - data
    TokenPairData:
      type: object
      properties:
        access:
          type: string
        refresh:
          type: string
        user:
          $ref: '#/components/schemas/AuthUser'
        mfa_required:
          type: boolean
      required:
      - access
      - refresh
      - user
    TokenPairEnvelope:
      type: object
      properties:
        data:
          $ref: '#/components/schemas/TokenPairData'
      required:
      - data
    VerifyEmail:
      type: object
      properties:
        token:
          type: string
      required:
      - token
    _CurrentUserData:
      type: object
      properties:
        id:
          type: string
          format: uuid
        email:
          type: string
          format: email
        display_name:
          type: string
        is_verified:
          type: boolean
        created_at:
          type: string
          format: date-time
      required:
      - created_at
      - display_name
      - email
      - id
      - is_verified
  securitySchemes:
    jwtAuth:
      type: http
      scheme: bearer
      bearerFormat: JWT
