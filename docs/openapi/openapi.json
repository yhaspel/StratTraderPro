          description: No response body
  /api/v1/brokers/tradestation/oauth/callback/:
    get:
      operationId: v1_brokers_tradestation_oauth_callback_retrieve
      tags:
      - v1
      security:
      - {}
      responses:
        '200':
          description: No response body
  /api/v1/brokers/tradestation/oauth/start/:
    get:
      operationId: v1_brokers_tradestation_oauth_start_retrieve
      tags:
      - v1
      security:
      - jwtAuth: []
      responses:
        '200':
          description: No response body
  /api/v1/fills/:
    get:
      operationId: fills_list
      tags:
