openapi: 3.0.3
info:
  title: StratTraderPro API
  version: 0.0.0
  description: Trading bot platform API — webhook-driven, regime-aware, multi-broker.
paths:
  /api/v1/auth/login/:
    post:
      operationId: auth_login
      description: Returns `{access, refresh, user, mfa_required}`. `mfa_required`
        is always false in M01 (MFA ships in M02).
      summary: Log in with email + password
      tags:
      - auth
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/Login'
            examples:
              LoginRequest:
                value:
                  email: trader@example.com
                  password: correct horse battery staple
                summary: Login request
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/Login'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/Login'
        required: true
      security:
      - jwtAuth: []
      - {}
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/TokenPairEnvelope'
          description: ''
        '401':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ErrorEnvelope'
              examples:
                InvalidCredentials:
                  value:
                    error:
                      code: INVALID_CREDENTIALS
                      message: Invalid email or password.
                  summary: Invalid credentials
          description: ''
        '403':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ErrorEnvelope'
              examples:
                EmailNotVerified:
                  value:
                    error:
                      code: EMAIL_NOT_VERIFIED
                      message: Please verify your email before signing in.
                  summary: Email not verified
          description: ''
        '423':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ErrorEnvelope'
              examples:
                AccountLocked:
                  value:
                    error:
                      code: ACCOUNT_LOCKED
                      message: Account temporarily locked due to repeated failures.
                  summary: Account locked
          description: ''
        '429':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ErrorEnvelope'
              examples:
                RateLimited:
                  value:
                    error:
                      code: RATE_LIMITED
                      message: Too many requests.
                  summary: Rate limited
          description: ''
  /api/v1/auth/logout/:
    post:
      operationId: auth_logout
      summary: Log out — revokes refresh family
      tags:
      - auth
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/Logout'
            examples:
              LogoutRequest:
                value:
                  refresh: eyJhbGciOi...refresh.jwt
                summary: Logout request
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/Logout'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/Logout'
        required: true
      security:
      - jwtAuth: []
      - {}
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/StatusEnvelope'
          description: ''
  /api/v1/auth/mfa/backup-codes/regenerate/:
    post:
      operationId: auth_mfa_regenerate_backup
      summary: Replace the user's set of backup codes with a fresh batch of 10.
      tags:
      - mfa
      security:
      - jwtAuth: []
      responses:
        '200':
          description: No response body
  /api/v1/auth/mfa/disable/:
    post:
      operationId: auth_mfa_disable
      summary: Disable MFA. Requires both current password and a current TOTP code.
      tags:
      - mfa
      security:
      - jwtAuth: []
      responses:
        '200':
          description: No response body
  /api/v1/auth/mfa/enroll/:
    post:
      operationId: auth_mfa_enroll
      description: Generate (or replace) a pending MFA device. Returns the QR PNG
        (base64) + raw secret. Confirm via /enroll/confirm/.
      summary: Begin TOTP enrollment
      tags:
      - mfa
      security:
      - jwtAuth: []
      responses:
        '200':
          description: No response body
  /api/v1/auth/mfa/enroll/confirm/:
    post:
      operationId: auth_mfa_enroll_confirm
      summary: Confirm TOTP enrollment with a verification code
      tags:
      - mfa
      security:
      - jwtAuth: []
      responses:
        '200':
          description: No response body
  /api/v1/auth/mfa/verify/:
    post:
      operationId: auth_mfa_verify
      summary: Complete MFA challenge — exchange mfa_token + code for tokens
      tags:
      - mfa
      security:
      - jwtAuth: []
      - {}
      responses:
        '200':
          description: No response body
  /api/v1/auth/oauth/exchange/:
    post:
      operationId: auth_oauth_exchange
      description: |-
        POST /api/v1/auth/oauth/exchange/

        Body: ``{"exchange": "<code>"}``
        Returns either:
          * ``{"access": "...", "refresh": "...", "user": {...}}`` — same as login
          * ``{"mfa_required": true, "mfa_token": "..."}`` — MFA-enrolled user

        The exchange code is consumed (single-use) regardless of whether the
        response includes tokens or an MFA challenge — the user proceeds to
        /auth/mfa/verify/ with the mfa_token to complete login.
      summary: Swap an OAuth exchange code for a JWT pair (or MFA challenge).
      tags:
      - oauth
      security:
      - jwtAuth: []
      - {}
      responses:
        '200':
          description: No response body
  /api/v1/auth/oauth/google/start/:
    get:
      operationId: auth_oauth_google_start
      description: |-
        GET /api/v1/auth/oauth/google/start/

        302s to Google's authorize URL via allauth's stock ``oauth2_login`` view.
        The frontend does ``window.location.assign('.../start/')`` — a top-level
        navigation, NOT an XHR. This is critical: the browser sets the session
        cookie that allauth uses to stash the OAuth state token, and that cookie
        must travel back when Google redirects to our /callback/. A cross-origin
        XHR followed by ``window.location`` drops that cookie and the callback
        rejects with ``PermissionDenied`` from ``verify_and_unstash_state``.
      summary: Redirect the browser to Google's OAuth authorize URL.
      tags:
      - oauth
      security:
      - jwtAuth: []
      - {}
      responses:
        '200':
          description: No response body
  /api/v1/auth/password/reset/:
    post:
      operationId: auth_password_reset
      description: Always returns 200 to avoid email enumeration.
      summary: Request a password reset email
      tags:
      - auth
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/PasswordReset'
            examples:
              ResetRequest:
                value:
                  email: trader@example.com
                summary: Reset request
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/PasswordReset'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/PasswordReset'
        required: true
      security:
      - jwtAuth: []
      - {}
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/StatusEnvelope'
          description: ''
        '429':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ErrorEnvelope'
              examples:
                RateLimited:
                  value:
                    error:
                      code: RATE_LIMITED
                      message: Too many requests.
                  summary: Rate limited
          description: ''
  /api/v1/auth/password/reset/confirm/:
    post:
      operationId: auth_password_reset_confirm
      description: Issues a JWT pair on success and revokes any outstanding refresh
        families.
      summary: Set a new password using the reset token
      tags:
      - auth
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/PasswordResetConfirm'
            examples:
              ConfirmRequest:
                value:
                  token: prv_7a1c...sample
                  password: correct horse battery staple
                summary: Confirm request
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/PasswordResetConfirm'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/PasswordResetConfirm'
        required: true
      security:
      - jwtAuth: []
      - {}
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/TokenPairEnvelope'
          description: ''
        '400':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ErrorEnvelope'
              examples:
                TokenInvalidOrExpired:
                  value:
                    error:
                      code: TOKEN_INVALID
                      message: Token is invalid or expired.
                  summary: Token invalid or expired
                PasswordDoesNotMeetPolicy:
                  value:
                    error:
                      code: PASSWORD_WEAK
                      message: Password does not meet policy.
                      details:
                        password:
                        - This password is too common.
                  summary: Password does not meet policy
          description: ''
  /api/v1/auth/refresh/:
    post:
      operationId: auth_refresh
      description: Consumes the supplied refresh token and issues a new pair in the
        same family. Reusing an already-rotated refresh revokes the whole family.
      summary: Rotate a refresh token
      tags:
      - auth
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/Refresh'
            examples:
              RefreshRequest:
                value:
                  refresh: eyJhbGciOi...refresh.jwt
                summary: Refresh request
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/Refresh'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/Refresh'
        required: true
      security:
      - jwtAuth: []
      - {}
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/TokenPairEnvelope'
          description: ''
        '401':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ErrorEnvelope'
              examples:
                TokenInvalidOrExpired:
                  value:
                    error:
                      code: TOKEN_INVALID
                      message: Token is invalid or expired.
                  summary: Token invalid or expired
          description: ''
  /api/v1/auth/register/:
    post:
      operationId: auth_register
      description: Creates a new user and sends a verification email. Duplicate emails
        return 202 with a generic body to prevent enumeration.
      summary: Register a new account
      tags:
      - auth
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/Register'
            examples:
              RegisterRequest:
                value:
                  email: trader@example.com
                  display_name: Jane Trader
                  password: correct horse battery staple
                summary: Register request
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/Register'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/Register'
        required: true
      security:
      - jwtAuth: []
      - {}
      responses:
        '201':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/RegisterOkEnvelope'
          description: ''
        '202':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/StatusEnvelope'
          description: ''
        '400':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ErrorEnvelope'
              examples:
                PasswordDoesNotMeetPolicy:
                  value:
                    error:
                      code: PASSWORD_WEAK
                      message: Password does not meet policy.
                      details:
                        password:
                        - This password is too common.
                  summary: Password does not meet policy
                ValidationError:
                  value:
                    error:
                      code: VALIDATION_ERROR
                      message: Invalid input.
                      details:
                        email:
                        - Enter a valid email address.
                  summary: Validation error
          description: ''
        '429':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ErrorEnvelope'
              examples:
                RateLimited:
                  value:
                    error:
                      code: RATE_LIMITED
                      message: Too many requests.
                  summary: Rate limited
          description: ''
  /api/v1/auth/resend-verification/:
    post:
      operationId: auth_resend_verification
      description: Idempotent. Always returns 200 to avoid email enumeration.
      summary: Resend verification email
      tags:
      - auth
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/ResendVerification'
            examples:
              ResendRequest:
                value:
                  email: trader@example.com
                summary: Resend request
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/ResendVerification'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/ResendVerification'
        required: true
      security:
      - jwtAuth: []
      - {}
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/StatusEnvelope'
          description: ''
        '429':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ErrorEnvelope'
              examples:
                RateLimited:
                  value:
                    error:
                      code: RATE_LIMITED
                      message: Too many requests.
                  summary: Rate limited
          description: ''
  /api/v1/auth/verify-email/:
    post:
      operationId: auth_verify_email
      description: Consumes the verification token and returns a JWT pair on success.
      summary: Verify email via token
      tags:
      - auth
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/VerifyEmail'
            examples:
              VerifyRequest:
                value:
                  token: uvv_6d2c...sample
                summary: Verify request
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/VerifyEmail'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/VerifyEmail'
        required: true
      security:
      - jwtAuth: []
      - {}
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/TokenPairEnvelope'
          description: ''
        '400':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ErrorEnvelope'
              examples:
                TokenInvalidOrExpired:
                  value:
                    error:
                      code: TOKEN_INVALID
                      message: Token is invalid or expired.
                  summary: Token invalid or expired
          description: ''
  /api/v1/brokers/:
    get:
      operationId: brokers_list
      tags:
      - brokers
      security:
      - jwtAuth: []
      responses:
        '200':
          description: No response body
    post:
      operationId: brokers_connect
      tags:
      - brokers
      security:
      - jwtAuth: []
      responses:
        '200':
          description: No response body
  /api/v1/brokers/{id}/:
    get:
      operationId: brokers_detail
      parameters:
      - in: path
        name: id
        schema:
          type: string
          format: uuid
        required: true
      tags:
      - brokers
      security:
      - jwtAuth: []
      responses:
        '200':
          description: No response body
    delete:
      operationId: brokers_remove
      parameters:
      - in: path
        name: id
        schema:
          type: string
          format: uuid
        required: true
      tags:
      - brokers
      security:
      - jwtAuth: []
      responses:
        '204':
          description: No response body
  /api/v1/brokers/{id}/flatten/:
    post:
      operationId: brokers_flatten
      description: Admin-gated debug flatten in M04 (full kill-switch engine in M08).
      parameters:
      - in: path
        name: id
        schema:
          type: string
          format: uuid
        required: true
      tags:
      - brokers
      security:
      - jwtAuth: []
      responses:
        '200':
          description: No response body
  /api/v1/brokers/{id}/mode/:
    post:
      operationId: brokers_set_mode
      description: |-
        PAPER ↔ LIVE mode switch (M05 §6.6 / AC-05-8). LIVE is rejected until the
        global flag is on AND the user has opted in — server-enforced regardless of
        UI. M05 always rejects LIVE (ENABLE_LIVE_TRADING defaults False).
      parameters:
      - in: path
        name: id
        schema:
          type: string
          format: uuid
        required: true
      tags:
      - brokers
      security:
      - jwtAuth: []
      responses:
        '200':
          description: No response body
  /api/v1/brokers/{id}/status/:
