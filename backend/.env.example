# StratTraderPro Backend — Environment Variables
# Copy this file to .env and fill in values.
# NEVER commit the real .env file.

# Core
SECRET_KEY=change-me-to-a-random-64-char-string
DJANGO_SETTINGS_MODULE=config.settings.dev

# Database (docker-compose default)
DATABASE_URL=postgres://stp_user:stp_local_pw@localhost:5432/strattraderpro

# Redis (docker-compose default)
REDIS_URL=redis://localhost:6379/0

# Sentry (leave empty to disable)
SENTRY_DSN=

# OpenTelemetry (leave empty to disable)
OTEL_EXPORTER_OTLP_ENDPOINT=

# ngrok (optional — for TradingView webhook testing)
NGROK_AUTHTOKEN=

# ─── Webhook ingest + broker execution (M04) ───
# Master rollback flags — flip OFF without a redeploy (plan §15).
WEBHOOK_V1_ENABLED=true
BROKER_ALPACA_ENABLED=true
# Hard paper-only default in M04; live keys are rejected by validation.
ENABLE_LIVE_TRADING=false
# Fill transport: leave false to use the Redis Stream + FillIngestor consumer.
FILLS_INLINE=false

# ─── Alpaca paper trading (M04) — LOCAL DEV SMOKE ONLY ───
# Production users connect their OWN paper keys via the UI (/settings/brokers),
# stored Fernet-encrypted per-user. These optional platform-level vars are only
# read by the `alpaca_smoke` management command. Generate keys in the Alpaca
# dashboard → Paper section (paper trading is free; regenerating invalidates the
# old pair). Paper keys start with "PK"; live keys ("AK") are rejected.
ALPACA_PAPER_KEY_ID=
ALPACA_PAPER_SECRET_KEY=

# ─── IB Gateway sidecar (PARKED — Alpaca pivot, ADR-041) ───
# The IBKR sidecar is opt-in only: `docker compose --profile ibkr up ib-gateway`.
# Its credentials + env contract live in docker/ib-gateway/ and docker-compose.yml
# (behind the `ibkr` profile). Do NOT put IBKR credentials here — the CI
# block-legacy-ibkr-creds gate fails if they reappear in active config.
