# StratTraderPro Backend — Environment Variables
# Copy this file to .env and fill in values.
# NEVER commit the real .env file.

# Core
SECRET_KEY=change-me-to-a-random-64-char-string
DJANGO_SETTINGS_MODULE=config.settings.dev

# Database (docker-compose default)
DATABASE_URL=postgres://stp_user:stp_local_pw@localhost:5432/strattraderpro

# Redis (docker-compose default)
REDIS_URL=redis://localhost:6379/0

# Sentry (leave empty to disable)
SENTRY_DSN=

# OpenTelemetry (leave empty to disable)
OTEL_EXPORTER_OTLP_ENDPOINT=

# ngrok (optional — for TradingView webhook testing)
NGROK_AUTHTOKEN=

# ─── IB Gateway sidecar (profile: docker compose --profile ibkr-spike up) ───
# Paper credentials for the IBKR account the sidecar logs into. Path B
# unified-login: put your live username/password here; TRADING_MODE=paper
# (set in docker-compose.yml) routes the session to the DU... paper sub-account.
# The full env contract for the sidecar lives in docker-compose.yml's
# ib-gateway service definition (TWS_ACCEPT_INCOMING, READ_ONLY_API,
# BYPASS_WARNING, EXISTING_SESSION_DETECTED_ACTION, etc.). See
# docs/adr/040-ibkr-gateway-sidecar.md Decision for what each variable does
# and docs/runbooks/ib-gateway-reauth.md for re-auth procedures. The IBC
# config-template overrides for gnzsnz 10.45.1e are baked into
# docker/ib-gateway/Dockerfile (sed patches) — not env-driven.
TWS_USERID=
TWS_PASSWORD=
# Optional — set to 1 to expose the Gateway GUI via VNC on localhost:5900
# (debug only; leaving VNC exposed in production is a security risk).
DEBUG_VNC=0
# Optional — override the default Asia/Jerusalem time zone for Gateway's clock.
# TIME_ZONE=Asia/Jerusalem
